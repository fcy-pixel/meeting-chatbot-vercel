{
  "name": "meeting-chatbot-vercel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev .vercel/output/static",
    "deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "extract": "tsx scripts/extract-pdfs.mts",
    "test": "tsx --test tests/*.test.ts",
    "test:acceptance": "tsx scripts/evaluate.mts",
    "test:conversation": "tsx scripts/evaluate-conversation.mts",
    "test:notebook": "tsx scripts/evaluate-notebook.mts"
  },
  "dependencies": {
    "next": "^15.0.0",
    "openai": "^4.47.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^0.12.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0",
    "vercel": "^37.0.0",
    "wrangler": "^3.78.0"
  }
}
